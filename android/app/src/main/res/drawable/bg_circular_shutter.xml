<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow / Ring -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2.5dp"
                android:color="@color/h2s_blue_light" />
            <solid android:color="#1A2563EB" />
        </shape>
    </item>
    <!-- Inner Solid Circle -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/h2s_blue" />
        </shape>
    </item>
</layer-list>
