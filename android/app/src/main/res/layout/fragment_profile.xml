<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/h2s_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Operator Card -->

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.06"
            android:text="PROFILE"
            android:textColor="@color/h2s_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="@color/h2s_text_muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demo User"
                android:textColor="@color/h2s_blue_light"
                android:textSize="18sp"
                android:textStyle="bold" />
                
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/h2s_divider" android:layout_marginVertical="12dp" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wristband"
                android:textColor="@color/h2s_text_muted"
                android:textSize="11sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WB-DEMO-001"
                android:textColor="@color/h2s_text_white"
                android:textSize="16sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- System Configuration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.06"
            android:text="@string/system_configuration"
            android:textColor="@color/h2s_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Config Row: Device Settings -->

            <!-- Config Row: Alert Thresholds -->
            <LinearLayout
                android:id="@+id/rowAlertThresholds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_warning_triangle"
                    app:tint="@color/h2s_text_muted" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Alert Thresholds"
                    android:textColor="@color/h2s_text_primary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/h2s_text_dim" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/h2s_divider"/>

            <!-- Config Row: Calibration -->
            <LinearLayout
                android:id="@+id/rowCalibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_history"
                    app:tint="@color/h2s_text_muted" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Calibration Schedule"
                    android:textColor="@color/h2s_text_primary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/h2s_text_dim" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sign Out Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignOut"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/h2s_red"
            android:drawableStart="@drawable/ic_sign_out"
            android:drawablePadding="10dp"
            android:letterSpacing="0.08"
            android:text="@string/sign_out_system"
            android:textAllCaps="true"
            android:textColor="@color/h2s_text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:lineSpacingExtra="2dp"
            android:text="@string/profile_footer"
            android:textColor="@color/h2s_text_dim"
            android:textSize="9.5sp" />

    </LinearLayout>
</ScrollView>
