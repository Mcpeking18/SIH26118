<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/h2s_bg">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/scannerTopBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/h2s_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Camera Viewfinder Frame -->
    <FrameLayout
        android:id="@+id/cameraPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#05080E"
        app:layout_constraintBottom_toTopOf="@id/cardOperationalProtocol"
        app:layout_constraintTop_toBottomOf="@id/scannerTopBar">

        <!-- Optional image view for uploaded/preview image -->
        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Viewfinder Reticle Overlay -->
        <com.mrpl.wristband.ui.view.ScannerReticleView
            android:id="@+id/scannerReticle"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Camera Telemetry Overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStandbyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:text="● STNDBY"
                    android:textColor="@color/h2s_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.04"
                    android:text="@string/scanner_cam_meta"
                    android:textColor="@color/h2s_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Torch and Switch Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnTorch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_badge_blue"
                    android:src="@drawable/ic_flash_toggle"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btnToggleMode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_badge_blue"
                    android:src="@drawable/ic_auto_mode"
                    app:tint="@color/h2s_yellow" />

                <ImageButton
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_badge_blue"
                    android:src="@drawable/ic_camera_switch"
                    app:tint="@color/white"
                    tools:visibility="visible" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Operational Protocol Card -->
    <LinearLayout
        android:id="@+id/cardOperationalProtocol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_card_rounded"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        app:layout_constraintBottom_toTopOf="@id/layoutScannerControls"
        app:layout_constraintTop_toBottomOf="@+id/cameraPreviewContainer"
        tools:layout_editor_absoluteX="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_shield_h2s"
            app:tint="@color/h2s_blue_light" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/operational_protocol_title"
                android:textColor="@color/h2s_text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/operational_protocol_desc"
                android:textColor="@color/h2s_text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls: Library, Shutter, Metric -->
    <LinearLayout
        android:id="@+id/layoutScannerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@id/cardEngineStatus">

        <!-- Library Upload Button -->
        <LinearLayout
            android:id="@+id/btnLibrary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_card_elevated_rounded"
                android:padding="8dp"
                android:src="@drawable/ic_gallery_library"
                app:tint="@color/h2s_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.08"
                android:text="@string/scanner_library"
                android:textColor="@color/h2s_text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Circular Glowing Shutter Button -->
        <LinearLayout
            android:id="@+id/btnInitiateScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circular_shutter">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_scan_camera"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.08"
                android:text="@string/scanner_initiate"
                android:textColor="@color/h2s_blue_light"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Metric Button -->
        <LinearLayout
            android:id="@+id/btnMetric"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_card_elevated_rounded"
                android:padding="8dp"
                android:src="@drawable/ic_metric"
                app:tint="@color/h2s_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.08"
                android:text="@string/scanner_metric"
                android:textColor="@color/h2s_text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Engine Status Strip -->
    <LinearLayout
        android:id="@+id/cardEngineStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_rounded"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toTopOf="@id/tvManualSensorEntry">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_unit_chip"
            app:tint="@color/h2s_text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="@string/engine_status"
            android:textColor="@color/h2s_text_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="@string/engine_ready"
            android:textColor="@color/h2s_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Enter Sensor ID Manually Link -->
    <TextView
        android:id="@+id/tvManualSensorEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:letterSpacing="0.06"
        android:padding="6dp"
        android:text="@string/enter_sensor_manually"
        android:textColor="@color/h2s_blue_light"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
